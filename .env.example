ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
DB_PASSWORD=docgen_pass_123
DATABASE_URL=postgresql+asyncpg://docgen:docgen_pass_123@localhost:5433/docgen
GENERATED_DOCS_PATH=./generated_docs

# Embedding model used for RAG (must match Vector dimension in schema)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIMENSION=384

# LLM provider selection: anthropic (default), groq, openai, ollama
DOCGEN_LLM_PROVIDER=anthropic
DOCGEN_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
DOCGEN_GROQ_MODEL=llama-3.3-70b-versatile
DOCGEN_OPENAI_MODEL=gpt-4o-mini
DOCGEN_OLLAMA_MODEL=llama3.1
DOCGEN_OLLAMA_URL=http://localhost:11434/v1

# Authentication
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
