ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
DB_PASSWORD=docgen_pass_123
DATABASE_URL=postgresql+asyncpg://docgen:docgen_pass_123@localhost:5433/docgen
GENERATED_DOCS_PATH=./generated_docs

# Embedding model used for RAG (must match Vector dimension in schema)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIMENSION=384

# LLM provider selection: anthropic (default), groq, openai, ollama
DOCGEN_LLM_PROVIDER=anthropic
DOCGEN_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
DOCGEN_GROQ_MODEL=llama-3.3-70b-versatile
DOCGEN_OPENAI_MODEL=gpt-4o-mini
DOCGEN_OLLAMA_MODEL=llama3.1
DOCGEN_OLLAMA_URL=http://localhost:11434/v1

# OpenRouter (used for chat models above with DOCGEN_LLM_PROVIDER=openrouter,
# and for the optional figure captioning step below)
OPENROUTER_API_KEY=

# Phase 3: optional Vision LLM captioning for FIGURE sections. Off by
# default - each figure costs one LLM call. When enabled, requires
# OPENROUTER_API_KEY above.
DOCGEN_ENABLE_FIGURE_CAPTIONING=false
# Comma-separated fallback list (free OpenRouter vision models rotate/rate-limit often)
DOCGEN_OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free,minimax/minimax-m3:free

# Authentication
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
